# Server-side Go API origin. This localhost value is for local development only.
# In Compose production it is http://app:8080: an internal service-network URL,
# never a browser value. Browser API requests always remain same-origin at /api.
# Production product API access requires an explicit deployment value; the build itself does not.
# This is intentionally not exposed through a NEXT_PUBLIC_* variable.
STOREFRONT_API_BASE_URL=http://127.0.0.1:8080

# Build-time base path. Leave empty for `npm run dev`; Compose builds the
# non-primary preview at /storefront-preview.
STOREFRONT_BASE_PATH=

# Optional browser navigation URL, resolved only on the server. Independent of the API origin.
# Absent in development: http://127.0.0.1:8080/#/login. Absent in production: no sign-in link.
# Use the same hostname for the local Next and Go pages so the host-only cookie is shared.
# Checkpoint A intentionally does not implement a return URL or hash bridge.
# STOREFRONT_LEGACY_LOGIN_URL=/legacy/#/login
