# Local demo examples only; never use these credentials in a deployment.
# Docker Compose: скопируйте файл в .env и смените пароль перед публичным запуском.
COMPOSE_PROJECT_NAME=sweetshop
APP_MODE=demo

# Public edge listener. Go itself is only reachable inside the Compose network.
APP_BIND=127.0.0.1
APP_PORT=8080
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_USER=sweetshop
POSTGRES_PASSWORD=local-demo-only
POSTGRES_DB=sweetshop

# В Docker hostname базы — postgres. Пароль здесь должен совпадать с POSTGRES_PASSWORD.
# Если пароль содержит : / ? # [ ] @, используйте percent-encoding в URL.
DATABASE_URL=postgres://sweetshop:local-demo-only@postgres:5432/sweetshop?sslmode=disable
RUN_MIGRATIONS=true

# Browser cookie sessions. Empty values use the demo/development defaults: the
# loopback edge (:8080) and standalone Next (:3000) origins and a non-Secure cookie for plain
# HTTP. In APP_MODE=production TRUSTED_ORIGINS is required (comma-separated
# exact https origins, e.g. https://shop.example) and SESSION_COOKIE_SECURE
# cannot be false; the server refuses to start otherwise.
TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=

WEB_DIR=/app/web
MIGRATIONS_DIR=/app/migrations

DB_MAX_CONNS=16
DB_MIN_CONNS=2
LOG_LEVEL=info

# Next is built with this non-primary, same-origin preview path. Changing a
# Next base path requires rebuilding its image. The browser remains on the
# edge origin and continues to call /api; it never sees the internal target.
STOREFRONT_BASE_PATH=/storefront-preview
STOREFRONT_PORT=3000
STOREFRONT_API_BASE_URL=http://app:8080

# Same-origin legacy login entry. Next adds validated, per-page returnTo.
# Only this root-relative canonical entry is supported; never use an API origin.
# Keep the quotes: dotenv parsers treat an unquoted # as the start of a comment.
STOREFRONT_LEGACY_LOGIN_URL="/legacy/#/login"
