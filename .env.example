# Local demo examples only; never use these credentials in a deployment.
# Docker Compose: скопируйте файл в .env и смените пароль перед публичным запуском.
COMPOSE_PROJECT_NAME=sweetshop
APP_MODE=demo

# Public edge listener. Go itself is only reachable inside the Compose network.
APP_BIND=127.0.0.1
APP_PORT=8080
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

POSTGRES_USER=sweetshop
POSTGRES_PASSWORD=local-demo-only
POSTGRES_DB=sweetshop

# В Docker hostname базы — postgres. Пароль здесь должен совпадать с POSTGRES_PASSWORD.
# Если пароль содержит : / ? # [ ] @, используйте percent-encoding в URL.
DATABASE_URL=postgres://sweetshop:local-demo-only@postgres:5432/sweetshop?sslmode=disable
# Empty uses the mode default: demo/development apply migrations at startup;
# production only verifies the schema and refuses to start until
#   docker compose run --rm --no-deps --entrypoint /app/shopctl app migrate
# has applied it. Only exact true/false override the default.
RUN_MIGRATIONS=

# Browser cookie sessions. Empty values use the demo/development defaults: the
# loopback edge (:8080) and standalone Next (:3000) origins and a non-Secure cookie for plain
# HTTP. In APP_MODE=production TRUSTED_ORIGINS is required (comma-separated
# exact https origins, e.g. https://shop.example) and SESSION_COOKIE_SECURE
# cannot be false; the server refuses to start otherwise.
TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=

# Staff (admin) sessions. Empty disables the staff API entirely (its routes
# return 404). When set: exact origins of a separate admin host, https-only in
# production, never overlapping TRUSTED_ORIGINS; requires PostgreSQL. The shop
# edge never routes /api/admin, so this stays unreachable until a separate
# admin origin exists.
STAFF_TRUSTED_ORIGINS=

# Transactional email. Empty EMAIL_TRANSPORT disables email; the shop works
# without it until self-registration needs it. Production requires
# EMAIL_TRANSPORT=smtp, SMTP_TLS=implicit (465) or starttls (587) with
# certificate verification, SMTP_USERNAME/SMTP_PASSWORD, and an https
# PUBLIC_SHOP_ORIGIN that is one of TRUSTED_ORIGINS (emailed links use it,
# never the request Host). EMAIL_TRANSPORT=log and SMTP_TLS=none are
# development-only. Local capture: docker compose --profile mail up -d mailpit,
# then EMAIL_TRANSPORT=smtp SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_TLS=none
# SMTP_FROM=shop@example.com PUBLIC_SHOP_ORIGIN=http://127.0.0.1:8080, and read
# mail at http://127.0.0.1:8025. Check a configuration with:
#   docker compose run --rm --no-deps --entrypoint /app/shopctl app email test --to you@example.com
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_SHOP_ORIGIN=

WEB_DIR=/app/web
MIGRATIONS_DIR=/app/migrations

DB_MAX_CONNS=16
DB_MIN_CONNS=2
LOG_LEVEL=info

# Next is built as the root artifact (no base path) and owns / at the edge.
# The browser stays on the edge origin and calls /api; it never sees the
# internal target below.
STOREFRONT_PORT=3000
STOREFRONT_API_BASE_URL=http://app:8080

# Edge route map. Supported values only:
#   default      Next owns / and unknown paths (the cutover state)
#   legacy-root  rollback: Go legacy owns / and unknown paths again
# Switching needs no rebuild: docker compose up -d --no-deps --force-recreate edge
# Any other value fails edge startup (no such deploy/nginx/<value>.conf.template).
EDGE_ROUTE_MAP=default
