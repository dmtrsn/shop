server {
    listen 8080;
    server_name _;

    # Browser-visible requests are always same-origin. Do not add CORS here.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    location = /edge/healthz {
        default_type application/json;
        return 200 '{"status":"ok"}\n';
    }

    location = /api {
        proxy_pass http://app:8080;
    }

    location ^~ /api/ {
        proxy_pass http://app:8080;
    }

    # Legacy web assets remain owned by Go during the migration.
    location = /assets {
        proxy_pass http://app:8080;
    }

    location ^~ /assets/ {
        proxy_pass http://app:8080;
    }

    # Next assets may be requested at the root after final cutover.
    location ^~ /_next/ {
        proxy_pass http://storefront:${STOREFRONT_PORT};
    }

    # Checkpoint A preview: Next receives its built-in base path unchanged.
    location = /storefront-preview {
        proxy_pass http://storefront:${STOREFRONT_PORT};
    }

    location ^~ /storefront-preview/ {
        proxy_pass http://storefront:${STOREFRONT_PORT};
    }

    # Primary route ownership remains Go until the later cutover checkpoint.
    location / {
        proxy_pass http://app:8080;
    }
}
