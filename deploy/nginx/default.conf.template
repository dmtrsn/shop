# --- Sign-in rate limits -------------------------------------------------
# This file is included inside nginx's http {} block, so the zones below are
# http-level and the server block attaches them.
#
# Key: $binary_remote_addr, the TCP peer of this nginx. Nothing here enables
# the real_ip module, so X-Forwarded-For, X-Real-IP and Forwarded can never
# change it. That is correct only while clients connect to this nginx
# directly. Behind another proxy (TLS terminator, load balancer, CDN, or
# Docker's userland proxy for a loopback-published port) every client arrives
# with that proxy's address and shares one bucket; see the README before
# deploying such a topology.
#
# Only POST verifies a password. Other methods map to an empty key, which
# limit_req does not account, so reading or ending a session is never limited.
map $request_method $auth_rate_limit_key {
    POST    $binary_remote_addr;
    default "";
}

# Customer sign-in: 10 per minute per client (one every 6 s) with a burst of
# 10, rejected immediately (nodelay) rather than queued toward bcrypt.
limit_req_zone $auth_rate_limit_key zone=customer_auth:10m rate=10r/m;

# Staff sign-in: 5 per minute (one every 12 s), burst 3. Defined for the future
# admin host only; the shop host attaches it nowhere because /api/admin is 404
# here. The admin server block must use:
#   limit_req zone=staff_auth burst=3 nodelay;   (Retry-After: 12)
limit_req_zone $auth_rate_limit_key zone=staff_auth:1m rate=5r/m;

# Self-service. Registration hashes a password and may send an email:
# 3 per minute per client (one every 20 s), burst 5. Registration resend and
# password-reset requests send an email without a password and share one
# zone: 3 per minute, burst 3. Registration confirmation verifies a password
# and shares the sign-in zone above. Password-reset confirmation is gated by
# an emailed token and hashes a new password: 6 per minute (one every 10 s),
# burst 6. Per-address email limits live in PostgreSQL; these zones bound
# the work one client can cause.
limit_req_zone $auth_rate_limit_key zone=customer_signup:10m rate=3r/m;
limit_req_zone $auth_rate_limit_key zone=customer_email:10m rate=3r/m;
limit_req_zone $auth_rate_limit_key zone=customer_token:10m rate=6r/m;

upstream shop_go {
    server app:8080;
    keepalive 16;
}

upstream shop_storefront {
    server storefront:${STOREFRONT_PORT};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    # Browser-visible requests are always same-origin. Do not add CORS here.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    limit_req_status 429;
    limit_req_log_level warn;

    location = /edge/healthz {
        default_type application/json;
        return 200 '{"status":"ok"}\n';
    }

    # Staff (admin) API is never served from the shop host: per ADR 006 it
    # belongs to a separate admin origin. This holds even when Go has
    # STAFF_TRUSTED_ORIGINS configured. Matching uses the normalized URI, so
    # encoded or doubled-slash spellings are caught too.
    location = /api/admin {
        return 404;
    }

    location ^~ /api/admin/ {
        return 404;
    }

    # Customer password verification is limited before it reaches Go.
    location = /api/auth/session {
        limit_req zone=customer_auth burst=10 nodelay;
        error_page 429 @auth_rate_limited;
        proxy_pass http://shop_go;
    }

    location = /api/auth/login {
        limit_req zone=customer_auth burst=10 nodelay;
        error_page 429 @auth_rate_limited;
        proxy_pass http://shop_go;
    }

    location = /api/auth/registration/confirm {
        limit_req zone=customer_auth burst=10 nodelay;
        error_page 429 @auth_rate_limited;
        proxy_pass http://shop_go;
    }

    location = /api/auth/registration {
        limit_req zone=customer_signup burst=5 nodelay;
        error_page 429 @registration_rate_limited;
        proxy_pass http://shop_go;
    }

    location = /api/auth/registration/resend {
        limit_req zone=customer_email burst=3 nodelay;
        error_page 429 @account_email_rate_limited;
        proxy_pass http://shop_go;
    }

    location = /api/auth/password-reset {
        limit_req zone=customer_email burst=3 nodelay;
        error_page 429 @account_email_rate_limited;
        proxy_pass http://shop_go;
    }

    location = /api/auth/password-reset/confirm {
        limit_req zone=customer_token burst=6 nodelay;
        error_page 429 @token_rate_limited;
        proxy_pass http://shop_go;
    }

    # A slot frees every 6 s at 10r/m, so the retry hint is exact. The body
    # says nothing about accounts or credentials.
    location @auth_rate_limited {
        default_type text/plain;
        add_header Retry-After 6 always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 429 "Too many sign-in attempts. Try again later.\n";
    }

    # customer_signup and customer_email free a slot every 20 s (3r/m).
    location @registration_rate_limited {
        default_type text/plain;
        add_header Retry-After 20 always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 429 "Too many registration requests. Try again later.\n";
    }

    location @account_email_rate_limited {
        default_type text/plain;
        add_header Retry-After 20 always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 429 "Too many email requests. Try again later.\n";
    }

    # customer_token frees a slot every 10 s (6r/m).
    location @token_rate_limited {
        default_type text/plain;
        add_header Retry-After 10 always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
        return 429 "Too many attempts. Try again later.\n";
    }

    location = /api {
        proxy_pass http://shop_go;
    }

    # Keep all authentication responses out of edge compression.
    location ^~ /api/auth/ {
        proxy_pass http://shop_go;
    }

    location ^~ /api/ {
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_types application/json;
        proxy_pass http://shop_go;
    }

    # Managed product media (ADR 019): public, read-only, served by Go from
    # its media volume. Not an API: only GET and HEAD reach Go.
    location = /media {
        return 404;
    }

    location ^~ /media/ {
        limit_except GET {
            deny all;
        }
        proxy_pass http://shop_go;
    }

    # Legacy web assets remain owned by Go during the migration.
    location = /assets {
        proxy_pass http://shop_go;
    }

    location ^~ /assets/ {
        proxy_pass http://shop_go;
    }

    location ^~ /_next/ {
        proxy_pass http://shop_storefront;
    }

    # Legacy's root-relative shell files, needed by /legacy until it is retired.
    location = /app.js { proxy_pass http://shop_go; }
    location = /migration.js { proxy_pass http://shop_go; }
    location = /styles.css { proxy_pass http://shop_go; }

    # Strip the compatibility mount: Go serves files relative to web/.
    location = /legacy {
        proxy_pass http://shop_go/;
    }

    location ^~ /legacy/ {
        proxy_pass http://shop_go/;
    }

    # Next owns / and every other path, including its own 404s.
    # Rollback: EDGE_ROUTE_MAP=legacy-root selects legacy-root.conf.template.
    location / {
        proxy_pass http://shop_storefront;
    }
}
